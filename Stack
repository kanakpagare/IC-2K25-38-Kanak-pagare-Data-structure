
#include <stdio.h>
#define SIZE 5

int stack[SIZE], top = -1;

void push(int x)
{
    stack[++top] = x;
}

void pop()
{
    printf("Deleted element: %d\n", stack[top--]);
}

void display()
{
    int i;
    printf("Stack elements: ");
    for(i = top; i >= 0; i--)
        printf("%d ", stack[i]);
    printf("\n");
}

int main()
{
    push(10);
    push(20);
    push(30);

    display();
    pop();
    display();

    return 0;
}
